# URL de conexão com o banco Postgres (Vercel Postgres, Neon, Supabase, etc.)
# Exemplo (Neon/Vercel Postgres costuma exigir sslmode=require):
# DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"
DATABASE_URL=""

# Limite (%) abaixo do qual um produto é sinalizado para negociação pontual.
# Pode ser alterado depois direto na tela de Configurações do dashboard.
NEXT_PUBLIC_DEFAULT_THRESHOLD=5
